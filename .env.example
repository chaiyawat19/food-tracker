# Database (Supabase / Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/food_tracker"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
